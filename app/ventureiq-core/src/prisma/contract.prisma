// use prisma-8

enum Role {
  USER
  ADMIN
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  subscriptions AlertSubscription[]
  alerts        Alert[]

  reports       MarketReport[]
  files         UploadedFile[]

  @@map("users")
}

model MarketCategory {
  id            String @id @default(uuid())
  name          String @unique
  slug          String @unique
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  companies     Company[]
  subscriptions AlertSubscription[]
  reports       MarketReport[]

  @@map("market_categories")
}

model MarketReport {
  id            String @id @default(uuid())
  title         String
  slug          String @unique
  summary       String
  content       String
  status        ReportStatus @default(DRAFT)
  industry      String 
  region        String?


  categoryId    String
  category      MarketCategory @relation(fields: [categoryId], references: [id])

  authorId      String
  author        User @relation(fields: [authorId], references: [id])

  datasets      Dataset[]
  alerts        Alert[]
  files         UploadedFile[]


  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([categoryId])
  @@index([status])

  @@map("market_reports")
}

model Dataset {
  id          String       @id @default(uuid())
  name        String
  description String?
  data        Json
  source      String?

  reportId String
  report   MarketReport @relation(
    fields: [reportId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([reportId])

  @@map("datasets")
}


model SearchIndexTerm {
  id            String   @id @default(uuid())
  term          String
  documentId    String
  documentType  String   @default("REPORT")
  termFrequency Int
  createdAt     DateTime @default(now())

  @@unique([term, documentId, documentType])
  @@index([term])
  @@index([documentId, documentType])

  @@map("search_index_terms")
}


model SearchDocumentStats {
  documentId   String
  documentType String   @default("REPORT")
  length       Int

  @@id([documentId, documentType])

  @@map("search_document_stats")
}

model Company {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  website      String?
  foundedYear  Int?
  headquarters String?

  categoryId String
  category   MarketCategory @relation(
    fields: [categoryId],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([categoryId])

  @@map("companies")
}


model AlertSubscription {
  id String @id @default(uuid())

  userId String
  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  categoryId String?
  category MarketCategory? @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Cascade
  )

  industry String?

  createdAt DateTime @default(now())

  @@unique([userId, categoryId, industry])
  @@index([categoryId])
  @@index([industry])

  @@map("alert_subscriptions")
}

model Alert {
  id String @id @default(uuid())

  userId String
  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  reportId String
  report MarketReport @relation(
    fields: [reportId],
    references: [id],
    onDelete: Cascade
  )

  message String
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])

  @@map("alerts")
}

model UploadedFile {
  id           String   @id @default(uuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  path         String

  reportId     String?
  report       MarketReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())

  @@index([reportId])
  @@index([uploadedById])
  @@map("uploaded_files")
}